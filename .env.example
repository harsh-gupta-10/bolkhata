# Server only. Never use NEXT_PUBLIC_ for these — the browser must not see them.
# Copy to .env.local for `npm run dev`. Typed khata works with neither key set.
# Voice stays off until GNANI_API_KEY is set. The app will not invent a Gnani transcript.
# Without OPENAI_API_KEY, chat falls back to the in-app parser. Default model is gpt-4o-mini.
GNANI_API_KEY=
OPENAI_API_KEY=

# Public Firebase web config.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=arcion-ecommerce-8b2.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=arcion-ecommerce-8b2
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=arcion-ecommerce-8b2.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=634571621217
NEXT_PUBLIC_FIREBASE_APP_ID=1:634571621217:web:65ecc4c00bbf2c496f7b20
